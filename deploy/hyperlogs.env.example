HYPERLOGS_ENV=production
HYPERLOGS_DEMO=0
HYPERLOGS_LAB_ENABLED=0
HYPERLOGS_DATA=/var/lib/hyperlogs
HYPERLOGS_PUBLIC_URL=https://hyperlogs.example.com
HYPERLOGS_ALLOWED_HOSTS=hyperlogs.example.com,localhost,127.0.0.1
# No passwords here. Bootstrap interactively with backend.manage before starting.

# Autoriza únicamente las LAN que administra esta instancia. Vacío desactiva las búsquedas.
# Ejemplo (sustituir por la red real): HYPERLOGS_DISCOVERY_NETWORKS=192.168.2.0/24
HYPERLOGS_DISCOVERY_NETWORKS=
